{
  "name": "dsh-workflow-kit",
  "version": "0.2.0",
  "description": "给 DeepSeek Harness 加一层多接收方任务流转：信箱、工单、自动接单、失败留证、定时巡检。",
  "type": "module",
  "main": "./lib/dsh-plugin.mjs",
  "exports": {
    ".": "./lib/dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "bin": { "dsh-workflow": "./bin/init.mjs" },
  "scripts": {
    "init": "node bin/init.mjs",
    "selfcheck": "node bin/selfcheck.mjs",
    "scan": "node scripts/scan-secrets.mjs ."
  },
  "files": ["bin", "lib", "docs", "templates", "scripts", "config.example.json", "cordis.patch.yml", "AGENTS.md", "README.md", "FEATURES.md", "compare.png", "LICENSE"],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "workflow", "multi-agent", "task-queue", "automation"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}
